# Entity: combat_style

main: kit: entity: combat_style: {

  alias: field: {}

  fields: {
    description: {
      h: "Description"
      n: "description"
      r: false
      sh: "Detailed description of the combat style"
      t: "`$STRING`"
    }
    forms: {
      h: "Forms"
      n: "forms"
      r: false
      sh: "List of forms or techniques within this combat style"
      t: "`$ARRAY`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Unique identifier for the combat style"
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "Name of the combat style"
      t: "`$STRING`"
    }
    type: {
      h: "Type"
      n: "type"
      r: false
      sh: "Type of combat style (Breathing Technique, Blood Demon Art, etc.)"
      t: "`$STRING`"
    }
    users: {
      h: "Users"
      n: "users"
      r: false
      sh: "Characters who use this combat style"
      t: "`$ARRAY`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "combat_style"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /combat-styles"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "name"
                or: "name"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "type"
                or: "type"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/combat-styles"
          q: {
            exist: [
              "name"
              "type"
            ]
          }
          s: [
            {
              lit: "combat-styles"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /combat-styles/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/combat-styles/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "combat-styles"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
