# Entity: combat_style

main: kit: entity: combat_style: {

  alias: field: {}

  fields: [
    {
      name: "description"
      req: false
      short: "Detailed description of the combat style"
      type: "`$STRING`"
    }
    {
      name: "forms"
      req: false
      short: "List of forms or techniques within this combat style"
      type: "`$ARRAY`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the combat style"
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "Name of the combat style"
      type: "`$STRING`"
    }
    {
      name: "type"
      req: false
      short: "Type of combat style (Breathing Technique, Blood Demon Art, etc.)"
      type: "`$STRING`"
    }
    {
      name: "users"
      req: false
      short: "Characters who use this combat style"
      type: "`$ARRAY`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "combat_style"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "name"
                orig: "name"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "type"
                orig: "type"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/combat-styles"
          parts: [
            "combat-styles"
          ]
          select: {
            exist: [
              "name"
              "type"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/combat-styles/{id}"
          parts: [
            "combat-styles"
            "{id}"
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
